<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Downloading the offline speech-to-text model at runtime -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Recording continues while the app is backgrounded or the screen is
         locked. Android only permits that from a foreground service, which
         must show a persistent notification for its whole lifetime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Held only while recording. The audio stack keeps the CPU alive on its
         own in the common case, but a device that dozes mid-recording loses
         audio, and this is the sanctioned way to say "not yet". -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- Android 13+ gates the service notification behind a runtime grant.
         Recording still works if it is denied; the notification is just not
         shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="McRecorder"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- stopWithTask: capture belongs to the Flutter engine, which dies
             with the activity. Keeping the service alive past that would show a
             "Recording" notification for a recording that is no longer
             happening. -->
        <service
            android:name=".RecordingService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

    </application>
</manifest>
