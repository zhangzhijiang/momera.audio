<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 replaced windowBackground with a system splash screen that
         always draws an icon and cannot be suppressed. Point it at the same
         mark the Dart splash opens on (see SplashGate) so the handoff from the
         system splash to Flutter's first frame has nothing to jump between.

         Left to itself the system would mask the launcher adaptive icon, which
         would put a near-white circle on a near-white field. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
